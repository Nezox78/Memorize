# Mode en ligne (comptes, classement, défis) — copier ce fichier en ".env" et le remplir.
# Les deux valeurs se trouvent dans Supabase : Project Settings → API.
# La clé "anon" est publique par conception ; ne mettez JAMAIS la clé "service_role" ici.
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
